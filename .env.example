# Copy this file to .env.local and fill in the keys you have.
# /api/assess automatically falls back to the built-in mock if none are set.

# Google Gemini — https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# OpenRouter — https://openrouter.ai/keys
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini

# Optional: force a specific provider instead of auto-detecting from the keys above.
# One of: gemini | openrouter
LLM_PROVIDER=

# Trained risk model service (backend/, see backend/SERVING.md). When reachable with a
# trained model loaded, /api/assess uses it (LLM only extracts features from the note);
# otherwise it transparently falls back to the LLM-only estimate above.
RISK_MODEL_URL=http://localhost:8000
