# Copy this file to .env.local and fill in the keys you have.
# /api/assess requires the Gemini API key below.

# Google Gemini — https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3-flash-preview

# Trained risk model service (backend/, see backend/SERVING.md). When reachable with a
# trained model loaded, /api/assess uses it (LLM only extracts features from the note);
# otherwise it transparently falls back to the LLM-only estimate above.
RISK_MODEL_URL=http://localhost:8000
